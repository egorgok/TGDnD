# Telegram Bot
# Get token from BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://dnd_user:dnd_password@localhost:5432/dnd_bot
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Gateways
# Text generation (GPT-6-Luna)
# Get API URL and token from https://ru.cheapvibecode.ru/
AI_TEXT_GATEWAY_URL=https://ru.cheapvibecode.ru/v1
AI_TEXT_GATEWAY_TOKEN=your_text_ai_token_here
AI_TEXT_MODEL=gpt-6-luna

# Image generation (GPT-Image-2)
# Get API URL and token from https://cheapvibecode.ru/
AI_IMAGE_GATEWAY_URL=https://cheapvibecode.ru/v1/images/generations
AI_IMAGE_GATEWAY_TOKEN=your_image_ai_token_here
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_QUALITY=low

# App settings
DEBUG=True
LOG_LEVEL=INFO
